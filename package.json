{
  "name": "softube-mixingstation-bridge",
  "version": "2.0.1",
  "description": "Bridge between Softube Console 1 and Mixing Station API",
  "scripts": {
    "test": "npm run test:frontend && cargo test --workspace",
    "test:frontend": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "fake:meters": "node tools/fake-metering-proxy.js --verbose",
    "fake:meters:proxy": "node tools/fake-metering-proxy.js --listen 8081 --upstream ws://127.0.0.1:8080",
    "fake:x32": "node tools/fake-metering-proxy.js --x32 --listen 10023",
    "repl": "node tools/ws-repl.js",
    "tauri": "tauri"
  },
  "keywords": [
    "softube",
    "console1",
    "mixingstation",
    "bridge",
    "midi",
    "ws",
    "websocket"
  ],
  "author": "Strejda603 <strejda603@centrum.cz>",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tauri-apps/cli": "^2.11.4",
    "@tsconfig/node22": "^22.0.5",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.0.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^3.2.7"
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/strejda603"
  }
}
