{
  "name": "softube-mixingstation-bridge",
  "version": "1.1.0",
  "description": "Bridge between Softube Console 1 and Mixing Station API",
  "main": "index.js",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "start": "node index.js",
    "fake:meters": "node tools/fake-metering-proxy.js --verbose",
    "fake:meters:proxy": "node tools/fake-metering-proxy.js --listen 8081 --upstream ws://127.0.0.1:8080",
    "fake:x32": "node tools/fake-metering-proxy.js --x32 --listen 10023",
    "gui": "electron app/main.js",
    "gui:verbose": "electron app/main.js --verbose",
    "repl": "node tools/ws-repl.js",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "postinstall": "electron-builder install-app-deps",
    "sync": "tools/sync-public-edition.sh"
  },
  "keywords": [
    "softube",
    "console1",
    "mixingstation",
    "bridge",
    "midi",
    "ws",
    "websocket"
  ],
  "author": "Strejda603 <strejda603@centrum.cz>",
  "license": "GPL-3.0-only",
  "dependencies": {
    "@julusian/midi": "^3.8.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.strejda603.console1msbridge",
    "productName": "Softube Console 1 MS Bridge",
    "compression": "maximum",
    "electronLanguages": [
      "en",
      "cs"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "app/**/*",
      "*.js",
      "LICENSE",
      "package.json",
      "README.md"
    ],
    "extraMetadata": {
      "main": "app/main.js"
    },
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.music",
      "icon": "icons/mac/icon.icns",
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] },
        { "target": "zip", "arch": ["x64", "arm64"] }
      ],
      "identity": "-",
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "icons/win/icon.ico",
      "target": [
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-win-${arch}.${ext}"
    },
    "linux": {
      "icon": "icons/png/",
      "category": "Audio",
      "target": [
        { "target": "deb", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  },
  "funding": {
    "type": "ko-fi",
    "url": "https://ko-fi.com/strejda603"
  },
  "allowScripts": {
    "@julusian/midi": true,
    "electron-winstaller": true
  }
}
