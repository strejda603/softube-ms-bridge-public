{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Softube Console 1 MS Bridge",
  "version": "2.0.1",
  "identifier": "com.strejda603.console1msbridge",
  "build": {
    "frontendDist": "../ui-dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Softube Console 1 MS Bridge",
        "width": 1200,
        "height": 850
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
